# Copia para .env.local em desenvolvimento. No Railway, define-as no separador Variables do serviço.
# Só nomes: nunca faças commit dos valores.
# Obrigatórias: MONGODB_URI, BETTER_AUTH_SECRET, SUPPRESSION_HASH_KEY, ADMIN_EMAILS, EMAIL_FROM.

# ─── Obrigatórias ──────────────────────────────────────────────────────────────

# Ligação ao MongoDB com o nome da base de dados. No Railway: ${{MongoDB.MONGO_URL}}/impactmail?authSource=admin
# Localmente: mongodb://127.0.0.1:27017/impactmail. Um replica set dá transações; um mongod simples funciona sem elas.
MONGODB_URI=

# Assina as sessões e, por chaves derivadas dele, todos os links dos emails enviados (cancelar, confirmar, rastreio).
# Pelo menos 32 caracteres aleatórios, senão o servidor não arranca: openssl rand -base64 48
# Mudá-lo termina todas as sessões e estraga os links dos emails já enviados.
BETTER_AUTH_SECRET=

# Chave dos hashes da lista de endereços a nunca enviar: endereços que o fornecedor disse não existirem (180 dias) e
# armadilhas de spam (para sempre). Pelo menos 32 caracteres aleatórios, diferentes de BETTER_AUTH_SECRET:
# openssl rand -base64 48. Mudá-la esvazia a lista.
SUPPRESSION_HASH_KEY=

# URL público da app, sem / no fim: os links dos emails e o Better Auth usam-no, e também a documentação, o documento
# OpenAPI e o /llms.txt (lidos no build). No Railway, sem ele, usa o domínio público do serviço (RAILWAY_PUBLIC_DOMAIN).
APP_URL=http://localhost:3000

# ─── Início de sessão ──────────────────────────────────────────────────────────

# Emails, separados por vírgulas, que abrem /admin. Também iniciam sessão.
ADMIN_EMAILS=
# Quem mais pode iniciar sessão: endereços e domínios inteiros (ana@example.com, @example.org). Vazio com ADMIN_EMAILS
# vazio: ninguém entra.
ALLOWED_EMAILS=

# Os emails do próprio ImpactMail (códigos e alertas) vão pelo Resend quando isto está definido. Sem ele vão pelo
# fornecedor de email (SES, ou um tenant próprio na PostShiba), a partir de EMAIL_FROM. Sem nenhum, em desenvolvimento
# o código aparece na consola; em produção não pode ser enviado.
RESEND_API_KEY=
# Remetente desses emails, num domínio verificado no Resend ou no fornecedor. Obrigatório. Na PostShiba precisa de um
# domínio de onde nenhuma newsletter envie.
EMAIL_FROM=

# Início de sessão com Google: o botão só aparece com os dois. A lista de acesso aplica-se.
# Redirect autorizado: <APP_URL>/api/auth/callback/google
# O mesmo cliente liga o Google Postmaster Tools em /admin (taxas de spam do Gmail): adiciona o redirect
# <APP_URL>/api/admin/postmaster/callback e ativa a Gmail Postmaster Tools API. Precisa também de
# CREDENTIALS_ENCRYPTION_KEY e CRON_SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: o domínio que o Postmaster Tools lê, um que assine com DKIM todos os emails. Por omissão, SHARED_DOMAIN.
POSTMASTER_DOMAIN=

# ─── Envio ─────────────────────────────────────────────────────────────────────

# Interruptor geral: nada vai para os leitores sem isto exatamente a "true". Códigos e alertas não esperam por ele.
SENDING_ENABLED=false

# postshiba ou ses. Vazio: postshiba quando POSTSHIBA_API_KEY existe, senão ses. Outro valor para o envio.
EMAIL_PROVIDER=

# Emails de campanha por segundo (por omissão 14, de 1 a 1000): a taxa máxima do SES, ou o limite por hora do cluster
# bulk da PostShiba a dividir por 3600.
SEND_RATE_PER_SECOND=

# ─── PostShiba ─────────────────────────────────────────────────────────────────

# Uma chave de acesso total da equipa e o id da equipa.
POSTSHIBA_API_KEY=
POSTSHIBA_TEAM_ID=
# O cluster por onde sai cada email.
POSTSHIBA_BULK_CLUSTER_ID=
# Opcional: um segundo cluster para emails de boas-vindas, confirmação e teste.
POSTSHIBA_TRANSACTIONAL_CLUSTER_ID=
# Segredo de assinatura do webhook da equipa em <APP_URL>/api/webhooks/postshiba.
POSTSHIBA_WEBHOOK_SECRET=
# Opcional, por omissão https://app.postshiba.com e https://inject.postshiba.com/api/inject/v1.
POSTSHIBA_API_URL=
POSTSHIBA_INJECT_URL=
# 32 bytes aleatórios em base64: openssl rand -base64 32. Encripta a palavra-passe SMTP de cada tenant e o refresh token
# do Postmaster Tools. Mudá-la torna-os ilegíveis.
CREDENTIALS_ENCRYPTION_KEY=

# ─── Amazon SES ────────────────────────────────────────────────────────────────

SES_REGION=us-east-1
# Chaves IAM para o SES. Obrigatórias para tudo o que é SES: não há recurso a ~/.aws nem a outras credenciais.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Os 12 dígitos da conta AWS: os ARN das identidades são construídos com eles.
SES_AWS_ACCOUNT_ID=
# ARN do tópico SNS que recebe devoluções, denúncias e entregas em /api/webhooks/ses.
SES_SNS_TOPIC_ARN=
# Opcional: tópico SNS com as mudanças de estado dos tenants (via EventBridge), subscrito em /api/webhooks/ses-tenants.
SES_TENANT_SNS_TOPIC_ARN=

# ─── Domínios ──────────────────────────────────────────────────────────────────

# Opcional: domínio partilhado, para newsletters sem domínio próprio enviarem de hello@<slug>.SHARED_DOMAIN. Precisa de
# um assistente de DNS (DNS_BROKER_URL, DNS_BROKER_SECRET) que não faz parte deste repositório. Sem ele, cada newsletter
# envia de um domínio seu.
SHARED_DOMAIN=
# Host para onde apontam com CNAME os subdomínios dos sites das newsletters (no Railway, o domínio do serviço). Sem ele,
# a página Domínios não pede subdomínio de site e os sites ficam em /archive/<slug> no APP_URL.
ARCHIVE_CNAME_TARGET=
DNS_BROKER_URL=
DNS_BROKER_SECRET=

# ─── Upstash QStash (envio em segundo plano e agendamentos) ────────────────────

# O QStash chama APP_URL/api/jobs/*, por isso APP_URL tem de ser público (ou usa o servidor de dev do QStash).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# ─── Imagens ───────────────────────────────────────────────────────────────────

# Carregamentos do editor, das definições da newsletter e da API, em accounts/<accountId>/images/. Com IMAGES_S3_BUCKET,
# vão para esse bucket S3 e são servidas de IMAGES_CDN_URL; senão para o Vercel Blob. Sem nenhum, ficam desligados.
IMAGES_S3_BUCKET=
IMAGES_S3_REGION=us-east-1
# Chaves de um utilizador IAM que só põe, lê e apaga objetos em accounts/ e cria invalidações no CloudFront.
IMAGES_S3_ACCESS_KEY_ID=
IMAGES_S3_SECRET_ACCESS_KEY=
# A CDN à frente do bucket (CloudFront), ex.: https://cdn.example.com. Define-a também no build.
IMAGES_CDN_URL=
# O ID da distribuição do CloudFront, para limpar a cache das imagens de uma conta apagada.
IMAGES_CLOUDFRONT_DISTRIBUTION_ID=
# Vercel Blob, quando não há bucket S3. Funciona fora da Vercel com o token do store.
BLOB_READ_WRITE_TOKEN=

# ─── Opcional ──────────────────────────────────────────────────────────────────

# Upstash Redis: limites partilhados entre réplicas. Sem ele, cada réplica conta em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Um bot do Telegram (do @BotFather) e o chat onde publica os alertas que precisam de alguém.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Liga as tarefas periódicas: o servidor chama /api/cron/hourly de hora a hora e /api/cron/postmaster uma vez por dia
# com "Authorization: Bearer <CRON_SECRET>" (lib/scheduler.js). openssl rand -hex 32
CRON_SECRET=
# off quando outro agendador chama essas rotas.
SCHEDULER=
